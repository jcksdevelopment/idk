--!strict
--[[
	Types
	Shared type definitions. These describe data shapes only; nothing in here is
	trusted on the server when it comes from a client.
]]

export type Rarity = "Trash" | "Rare" | "Legendary"
export type ItemState = "Dirty" | "Repairing" | "Clean"

-- Persistent, server-owned record of one inventory item.
export type ItemRecord = {
	Id: string, -- GUID generated by the server
	TemplateId: string, -- key into Items catalog
	Rarity: Rarity,
	State: ItemState,
	Quality: number, -- value multiplier rolled server-side (0.80 - 1.25)
	AcquiredAt: number, -- os.time()
	RepairStartedAt: number?, -- os.time() when repair started
	RepairEndsAt: number?, -- os.time() when repair may be completed
}

export type PlayerStats = {
	CratesOpened: number,
	ItemsSold: number,
	ItemsRepaired: number,
	RobuxPurchases: number,
}

export type Moderation = {
	TotalFlags: number,
	LastFlagAt: number,
	LastFlagReason: string,
}

-- Everything that is persisted to the DataStore for one player.
export type PlayerData = {
	SchemaVersion: number,
	Cash: number,
	LifetimeEarned: number,
	Inventory: { [string]: ItemRecord },
	InstantRepairTokens: number,
	BoostEndsAt: number, -- os.time() when the 2x money boost expires
	PurchaseHistory: { string }, -- recent ProcessReceipt PurchaseIds (idempotency)
	Stats: PlayerStats,
	Moderation: Moderation,
}

-- Read-only view of an item sent to the owning client for display.
export type ItemView = {
	Id: string,
	TemplateId: string,
	Name: string,
	Icon: string,
	Rarity: Rarity,
	State: ItemState,
	RepairStartedAt: number?,
	RepairEndsAt: number?,
	SellValue: number,
	CleanValue: number,
	AcquiredAt: number,
}

export type PassFlags = {
	VIPAutoCleaner: boolean,
	ExtraCapacity: boolean,
}

-- Full state snapshot replicated server -> owning client.
export type Snapshot = {
	Cash: number,
	LifetimeEarned: number,
	Items: { ItemView },
	Capacity: number,
	RepairSlots: number,
	ActiveRepairs: number,
	InstantRepairTokens: number,
	BoostEndsAt: number,
	MoneyMultiplier: number,
	Passes: PassFlags,
	PendingInstantRepair: string?,
	ServerTime: number,
}

export type NotifyKind = "success" | "error" | "info" | "reveal"

return nil
