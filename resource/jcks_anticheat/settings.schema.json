    },
    {
      "id": "injection",
      "title": "Injection & menus",
      "fields": [
        {
          "key": "textureBlacklist",
          "label": "Blacklisted texture dictionaries",
          "type": "list",
          "help": "Texture dictionaries only cheat menus stream in. Add names you've confirmed on your server; empty by default."
        }
      ]
    },
    {
      "id": "vision",
      "title": "AI vision",
      "fields": [
        {
          "key": "vision.enabled",
          "label": "Enabled",
          "type": "bool"
        },
        {
          "key": "vision.provider",
          "label": "Provider",
          "type": "select",
          "options": [
            "anthropic",
            "openai-compatible"
          ]
        },
        {
          "key": "vision.endpoint",
          "label": "Endpoint",
          "type": "string"
        },
        {
          "key": "vision.model",
          "label": "Model",
          "type": "string"
        },
        {
          "key": "vision.apiKeyEnv",
          "label": "API key environment variable",
          "type": "string",
          "help": "The key itself is never stored in config."
        },
        {
          "key": "vision.effort",
          "label": "Effort",
          "type": "select",
          "options": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "key": "vision.flagConfidence",
          "label": "Flag at confidence",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "key": "vision.cooldownSeconds",
          "label": "Capture cooldown (s)",
          "type": "number",
          "min": 10,
          "max": 3600,
          "step": 5
        },
        {
          "key": "vision.maxStoredCaptures",
          "label": "Captures kept on disk",
          "type": "number",
          "min": 10,
          "max": 100000,
          "step": 10
