{
  "version": 1,
  "sections": [
    {
      "id": "general",
      "title": "General",
      "fields": [
        {
          "key": "dryRun",
          "label": "Dry run",
          "type": "bool",
          "help": "Log every detection but never kick or ban. Use it while tuning."
        },
        {
          "key": "adminAce",
          "label": "Bypass ACE permissions",
          "type": "list",
          "help": "Players with any of these ACEs are logged but never punished."
        },
        {
          "key": "maxHealth",
          "label": "Max health",
          "type": "number",
          "help": "Highest health a player may legitimately have.",
          "min": 100,
          "max": 10000,
          "step": 1
        },
        {
          "key": "expectedDamageModifier",
          "label": "Expected weapon damage modifier",
          "type": "number",
          "help": "Set if your server changes SetPlayerWeaponDamageModifier.",
          "min": 0.1,
          "max": 10,
          "step": 0.05
        }
      ]
    },
    {
      "id": "scoring",
      "title": "Scoring & punishment",
      "fields": [
        {
          "key": "scoring.screenshotAt",
          "label": "Screenshot at score",
          "type": "number",
          "min": 1,
          "max": 1000,
          "step": 1
        },
        {
          "key": "scoring.kickAt",
          "label": "Kick at score",
          "type": "number",
          "min": 1,
          "max": 1000,
          "step": 1
        },
        {
          "key": "scoring.banAt",
          "label": "Ban at score",
          "type": "number",
          "help": "Bans always need server-side evidence; client flags alone stop at a kick.",
          "min": 1,
          "max": 2000,
          "step": 1
        },
        {
          "key": "scoring.halfLifeMinutes",
          "label": "Score half-life (minutes)",
          "type": "number",
          "min": 1,
          "max": 1440,
          "step": 1
        },
        {
          "key": "scoring.ignore",
          "label": "Ignored codes",
          "type": "codes",
          "help": "Switched off entirely. The client stops reporting them."
        },
        {
          "key": "scoring.logOnly",
          "label": "Log-only codes",
          "type": "codes",
          "help": "Recorded and shown, never punished."
        },
        {
          "key": "scoring.dropImmediately",
          "label": "Disconnect-immediately codes",
          "type": "codes",
          "help": "Kick at once regardless of score (never a ban by themselves)."
        }
      ]
    },
    {
      "id": "heartbeat",
      "title": "Heartbeat & network",
      "fields": [
        {
          "key": "heartbeatIntervalMs",
          "label": "Heartbeat interval (ms)",
          "type": "number",
          "min": 1000,
          "max": 30000,
          "step": 500
        },
        {
          "key": "heartbeatMissingSeconds",
          "label": "Missing heartbeat after (s)",
          "type": "number",
          "min": 5,
          "max": 300,
          "step": 1
        },
        {
          "key": "handshakeTimeoutSeconds",
          "label": "Handshake timeout (s)",
          "type": "number",
          "help": "Time in the world before a client must have handshaked.",
          "min": 30,
          "max": 600,
          "step": 5
        },
        {
          "key": "eventBurst",
          "label": "Event burst per player",
          "type": "number",
          "min": 5,
          "max": 1000,
          "step": 1
        },
        {
          "key": "eventRefillPerSecond",
          "label": "Events per second per player",
          "type": "number",
          "min": 1,
          "max": 500,
          "step": 1
        },
        {
          "key": "floodDeniedPer10s",
          "label": "Flood: denied events per 10 s",
          "type": "number",
          "min": 5,
          "max": 1000,
          "step": 1
        },
        {
          "key": "honeypotEvents",
          "label": "Honeypot event names",
          "type": "list",
          "help": "Decoy events nothing legitimate triggers."
        }
      ]
    },
    {
      "id": "movement",
      "title": "Movement",
      "fields": [
        {
          "key": "movement.onFootMaxSpeed",
          "label": "On-foot max speed (m/s)",
          "type": "number",
          "min": 5,
          "max": 100,
          "step": 0.5
        },
        {
          "key": "movement.landMaxSpeed",
          "label": "Land vehicle max speed (m/s)",
          "type": "number",
          "min": 20,
          "max": 300,
          "step": 1
        },
        {
          "key": "movement.boatMaxSpeed",
          "label": "Boat max speed (m/s)",
          "type": "number",
          "min": 10,
          "max": 200,
          "step": 1
        },
        {
          "key": "movement.airMaxSpeed",
          "label": "Aircraft max speed (m/s)",
          "type": "number",
          "min": 20,
          "max": 400,
          "step": 1
        },
        {
          "key": "movement.teleportMinDistance",
          "label": "Teleport min distance (m)",
          "type": "number",
          "min": 10,
          "max": 1000,
          "step": 5
        },
        {
          "key": "movement.speedSlack",
          "label": "Speed slack multiplier",
          "type": "number",
          "min": 1,
          "max": 3,
          "step": 0.05
        }
      ]
    },
    {
      "id": "combat",
      "title": "Combat",
      "fields": [
        {
          "key": "damage.bodyDamageMultiplier",
          "label": "Max body damage \u00d7 baseline",
          "type": "number",
          "min": 1,
          "max": 10,
          "step": 0.1
        },
        {
          "key": "damage.headDamageMultiplier",
          "label": "Max headshot damage \u00d7 baseline",
          "type": "number",
          "min": 1,
          "max": 20,
          "step": 0.1
        },
        {
          "key": "damage.rangeMultiplier",
          "label": "Max range \u00d7 weapon range",
          "type": "number",
          "min": 1,
          "max": 5,
          "step": 0.05
        },
        {
          "key": "damage.maxAimAngle",
          "label": "Silent aim: max facing angle (\u00b0)",
          "type": "number",
          "min": 10,
          "max": 180,
          "step": 1
        },
        {
          "key": "damage.maxTrajectoryAngle",
          "label": "Max bullet trajectory deviation (\u00b0)",
          "type": "number",
          "min": 5,
          "max": 90,
          "step": 1
        },
        {
          "key": "damage.headshotRatioMax",
          "label": "Max headshot ratio",
          "type": "number",
          "min": 0.1,
          "max": 1,
          "step": 0.01
        },
        {
          "key": "maxWeapons",
          "label": "Max weapons held at once",
          "type": "number",
          "help": "More than this looks like a 'give all weapons' option.",
          "min": 5,
          "max": 200,
          "step": 1
        },
        {
          "key": "weaponBlacklist",
          "label": "Blacklisted weapons",
          "type": "list",
          "help": "Weapon names, e.g. WEAPON_RPG."
        }
      ]
    },
    {
