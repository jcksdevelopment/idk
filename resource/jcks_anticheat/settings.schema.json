{
  "version": 1,
  "sections": [
    {
      "id": "general",
      "title": "General",
      "fields": [
        {
          "key": "dryRun",
          "label": "Dry run",
          "type": "bool",
          "help": "Log every detection but never kick or ban. Use it while tuning."
        },
        {
          "key": "adminAce",
          "label": "Bypass ACE permissions",
          "type": "list",
          "help": "Players with any of these ACEs are logged but never punished or countered. For a single detection add the code: e.g. add_ace group.police jcks_anticheat.bypass.WPN_GIVE_ALL allow."
        },
        {
          "key": "maxHealth",
          "label": "Max health",
          "type": "number",
          "help": "Highest health a player may legitimately have.",
          "min": 100,
          "max": 10000,
          "step": 1
        },
        {
          "key": "expectedDamageModifier",
          "label": "Expected weapon damage modifier",
          "type": "number",
          "help": "Set if your server changes SetPlayerWeaponDamageModifier.",
          "min": 0.1,
          "max": 10,
          "step": 0.05
        }
      ]
    },
    {
      "id": "scoring",
      "title": "Scoring & punishment",
      "fields": [
        {
          "key": "countermeasures.enabled",
          "label": "Undo cheat effects (countermeasures)",
          "type": "bool",
          "help": "Even when a detection only logs or warns, its effect is reverted: spawned entities deleted/blocked, godmode/invisibility/noclip/spectate switched off, health/armour/vehicle repair/plate/handling restored, teleports put back, unauthorised revives killed, extra weapons removed, explosions/projectiles/fires/particles cancelled. Health, armour and revive reverts need the shield installed (it tells legitimate heals apart)."
        },
        {
          "key": "countermeasures.skip",
          "label": "Codes to leave alone",
          "type": "codes",
          "help": "Detections whose effect is not reverted (still detected and scored)."
        },
        {
          "key": "scoring.screenshotAt",
          "label": "Screenshot at score",
          "type": "number",
          "min": 1,
          "max": 1000,
          "step": 1
        },
        {
          "key": "scoring.kickAt",
          "label": "Kick at score",
          "type": "number",
          "min": 1,
          "max": 1000,
          "step": 1
        },
        {
          "key": "scoring.banAt",
          "label": "Ban at score",
          "type": "number",
          "help": "Bans always need server-side evidence; client flags alone stop at a kick.",
          "min": 1,
          "max": 2000,
          "step": 1
        },
        {
          "key": "scoring.halfLifeMinutes",
          "label": "Score half-life (minutes)",
          "type": "number",
          "min": 1,
          "max": 1440,
          "step": 1
        },
        {
          "key": "scoring.severity",
          "label": "Severity overrides",
          "type": "map",
          "help": "One per line as CODE=points, e.g. VEH_HANDLING=10. Overrides the default score a detection adds (see docs/THREAT_MATRIX.md for codes and defaults).",
          "upperKeys": true
        },
        {
          "key": "scoring.ignore",
          "label": "Ignored codes",
          "type": "codes",
          "help": "Switched off entirely. The client stops reporting them."
        },
        {
          "key": "scoring.logOnly",
          "label": "Log-only codes",
          "type": "codes",
          "help": "Recorded and shown, never punished."
        },
        {
          "key": "scoring.dropImmediately",
          "label": "Disconnect-immediately codes",
          "type": "codes",
          "help": "Kick at once regardless of score (never a ban by themselves)."
        },
        {
          "key": "scoring.alwaysBan",
          "label": "Ban-immediately codes",
          "type": "codes",
          "help": "Ban on the first detection regardless of score, e.g. NET_HONEYPOT or WPN_EXPLOSION_BLAME. Use only for codes you trust on your server."
        }
      ]
    },
    {
      "id": "integrations",
      "title": "Resource integrations",
      "fields": [
        {
          "key": "integrations.resources",
          "label": "Trusted resources",
          "type": "maplist",
          "help": "One per line as resource=behaviour,behaviour. When that resource heals, teleports, etc. the player (seen by the shield), the matching detections are paused for a moment. Behaviours: heal, armor, godmode, teleport, invisible, noclip, spectate, vehicle, weapons, camera, ragdoll, vision, superjump, * (everything)."
        },
        {
          "key": "integrations.usePresets",
          "label": "Use built-in presets",
          "type": "bool",
          "help": "Rules for popular resources (txAdmin, vMenu, qb-*, esx_*, ox_inventory, appearance, garages, mechanics, phones...) from integrations.presets.json, applied to resources you run. Your own rules override them."
        },
        {
          "key": "integrations.clientTrustAllResources",
          "label": "Trust every resource file on the client",
          "type": "bool",
          "help": "When any resource's own script (not injected code) heals, revives, teleports, etc. the player, the matching client detections and countermeasures pause for 3 s. Prevents killing players revived by a custom death script you haven't listed. Server-side grace still requires Trusted resources. Code injected by executors is never trusted."
        },
        {
          "key": "integrations.serverTrustReportedResources",
          "label": "Server trusts reported resource actions",
          "type": "bool",
          "help": "The server accepts heals/teleports/etc. that the shield saw a running resource perform (sent inside the encrypted heartbeat), pausing its own checks for 3 s. Turn off for strict mode: only Trusted resources get server-side grace."
        },
        {
          "key": "integrations.learning",
          "label": "Learning mode",
          "type": "bool",
          "help": "Records what each resource does to players. 'jac integrations suggest' lists rules to add, 'jac integrations apply' saves them."
        },
        {
          "key": "integrations.graceMs",
          "label": "Grace after a trusted action (ms)",
          "type": "number",
          "min": 500,
          "max": 120000,
          "step": 500
        }
      ]
    },
