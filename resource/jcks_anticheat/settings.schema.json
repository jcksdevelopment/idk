      "id": "backdoor",
      "title": "Backdoor scanner",
      "fields": [
        {
          "key": "backdoorScanner.enabled",
          "label": "Enabled",
          "type": "bool",
          "help": "Scans every resource's .lua/.js/.cs files for backdoor patterns: remote code execution, shell commands, secret convars, ACE grants, manifest writes, encoded payloads, obfuscated JS."
        },
        {
          "key": "backdoorScanner.scanOnStart",
          "label": "Scan on every server start",
          "type": "bool",
          "help": "Results are printed to the server console with an id per finding. Run 'jac scan' any time."
        },
        {
          "key": "backdoorScanner.minSeverity",
          "label": "Report from severity",
          "type": "select",
          "options": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "key": "backdoorScanner.autoAction",
          "label": "Automatic action",
          "type": "select",
          "options": [
            "none",
            "remove",
            "quarantine"
          ],
          "help": "none = only report and wait for 'jac scan remove|quarantine <id>'. remove deletes the flagged line (backup kept as .jac-bak). quarantine moves the file into .jac-quarantine/."
