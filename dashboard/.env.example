# Signs staff session cookies. 32+ random characters. Required when SENTINEL_DEMO=0 in production.
SESSION_SECRET=

# Shared secret the game server sends as "Authorization: Bearer ...". Must match the env var
# named by dashboard.secretEnv in resource/sentinel/config.json (default SENTINEL_DASHBOARD_SECRET).
SENTINEL_DASHBOARD_SECRET=

# Demo data and a simulated detection feed. Set to 0 in production.
SENTINEL_DEMO=1

# Where state.json and captured screenshots are stored (default ./.data).
# SENTINEL_DATA_DIR=
