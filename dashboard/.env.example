# Signs staff session cookies. 32+ random characters. Required when JCKS_AC_DEMO=0 in production.
SESSION_SECRET=

# Shared secret the game server sends as "Authorization: Bearer ...". Must match the env var
# named by dashboard.secretEnv in resource/jcks_anticheat/config.json (default JCKS_AC_DASHBOARD_SECRET).
JCKS_AC_DASHBOARD_SECRET=

# Demo data and a simulated detection feed. Set to 0 in production.
JCKS_AC_DEMO=1

# Where state.json and captured screenshots are stored (default ./.data).
# JCKS_AC_DATA_DIR=

# Captures kept before the oldest dismissed/clean ones are deleted (default 1000).
# JCKS_AC_MAX_CAPTURES=1000
